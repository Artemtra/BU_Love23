<Window x:Class="BU_Love.Views.AdminPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Админ-панель" 
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1a1a1a"
        Foreground="White"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2d2d2d" Padding="30,0">
            <Grid>
                <TextBlock Text="🔑 АДМИН-ПАНЕЛЬ" FontSize="28" FontWeight="Bold" Foreground="#FF9800" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnProducts" Content="📦 Товары" Click="ShowProducts_Click" 
                            Background="#2196F3" Foreground="White" FontSize="16" FontWeight="Bold"
                            Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button x:Name="BtnCategories" Content="📁 Категории" Click="ShowCategories_Click" 
                            Background="#9C27B0" Foreground="White" FontSize="16" FontWeight="Bold"
                            Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button x:Name="BtnOrders" Content="📋 Заказы" Click="ShowOrders_Click" 
                            Background="#FF5722" Foreground="White" FontSize="16" FontWeight="Bold"
                            Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button Content="✕ Выйти" Click="ExitButton_Click" Background="#ff4444" Foreground="White"
                            FontSize="16" FontWeight="Bold" Padding="20,10" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="30">
            <StackPanel>

                <!-- ====== ТОВАРЫ ====== -->
                <StackPanel x:Name="ProductsPanel">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="📦 ТОВАРЫ" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="➕ Добавить товар" Click="AddProduct_Click"
                                    Background="#4CAF50" Foreground="White" FontSize="16" FontWeight="Bold"
                                    Padding="15,10" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>

                            <!-- Кнопка "Удалить все товары" -->
                            <Button Content="🗑️ Удалить всё" Click="DeleteAllProducts_Click"
                                    Background="#D32F2F" Foreground="White" FontSize="16" FontWeight="Bold"
                                    Padding="15,10" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="ProductForm" Background="#2d2d2d" Padding="25" CornerRadius="10" 
        Margin="0,0,0,20" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ProductFormTitle" Text="Добавление товара" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Название" Margin="0,0,0,5"/>
                                    <TextBox x:Name="ProductName" FontSize="16" Padding="10" Background="#1a1a1a" 
                         Foreground="White" BorderBrush="#4a4a4a" Margin="0,0,0,10"/>

                                    <TextBlock Text="Описание" Margin="0,0,0,5"/>
                                    <TextBox x:Name="ProductDesc" FontSize="16" Padding="10" Background="#1a1a1a" 
                         Foreground="White" BorderBrush="#4a4a4a" Height="80" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <TextBlock Text="Цена" Margin="0,0,0,5"/>
                                    <TextBox x:Name="ProductPrice" FontSize="16" Padding="10" Background="#1a1a1a" 
                         Foreground="White" BorderBrush="#4a4a4a" Margin="0,0,0,10"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <!-- Выпадающий список категорий -->
                                    <TextBlock Text="Категория" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="ProductCategoryCombo" 
                          FontSize="16" 
                          Padding="10" 
                          Background="#1a1a1a" 
                          Foreground="White" 
                          BorderBrush="#4a4a4a"
                          Margin="0,0,0,10"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          IsEditable="False">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Background" Value="#2d2d2d"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="Padding" Value="10,5"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FF9800"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#FF9800"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>

                                    <TextBlock Text="Количество" Margin="0,0,0,5"/>
                                    <TextBox x:Name="ProductStock" FontSize="16" Padding="10" Background="#1a1a1a" 
                         Foreground="White" BorderBrush="#4a4a4a" Margin="0,0,0,10"/>

                                    <!-- Выпадающий список состояния -->
                                    <TextBlock Text="Состояние" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="ProductConditionCombo" 
                          FontSize="16" 
                          Padding="10" 
                          Background="#1a1a1a" 
                          Foreground="White" 
                          BorderBrush="#4a4a4a"
                          Margin="0,0,0,10">
                                        <ComboBoxItem Content="Отличное" Tag="Excellent"/>
                                        <ComboBoxItem Content="Хорошее" Tag="Good"/>
                                        <ComboBoxItem Content="Удовлетворительное" Tag="Fair"/>
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Background" Value="#2d2d2d"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="Padding" Value="10,5"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FF9800"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#FF9800"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                <Button Content="📷 Выбрать фото" Click="UploadProductImage_Click"
                    Background="#FF9800" Foreground="White" FontSize="14" FontWeight="Bold"
                    Padding="15,8" BorderThickness="0" Cursor="Hand"/>
                                <TextBlock x:Name="ProductImagePath" Text="" FontSize="12" Foreground="#aaaaaa" 
                       VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="💾 Сохранить" Click="SaveProduct_Click"
                    Background="#4CAF50" Foreground="White" FontSize="16" FontWeight="Bold"
                    Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                                <Button Content="❌ Отмена" Click="CancelForm_Click"
                    Background="#ff4444" Foreground="White" FontSize="16" FontWeight="Bold"
                    Padding="20,10" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Список товаров -->
                    <ItemsControl x:Name="ProductsList" ItemsSource="{Binding Products}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,5" Background="#2d2d2d" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Price, StringFormat={}{0:C}}" Foreground="#4CAF50" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="✏️" Tag="{Binding Product}" Click="EditProduct_Click"
                                                    Background="#2196F3" Foreground="White" Width="35" Height="35"
                                                    BorderThickness="0" Cursor="Hand" Margin="0,0,5,0"/>
                                            <Button Content="🗑️" Tag="{Binding Product}" Click="DeleteProduct_Click"
                                                    Background="#ff4444" Foreground="White" Width="35" Height="35"
                                                    BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ====== КАТЕГОРИИ ====== -->
                <StackPanel x:Name="CategoriesPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="📁 КАТЕГОРИИ" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="➕ Добавить категорию" Click="AddCategory_Click"
                                    Background="#9C27B0" Foreground="White" FontSize="16" FontWeight="Bold"
                                    Padding="15,10" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>

                            <!-- Кнопка "Удалить все категории" -->
                            <Button Content="🗑️ Удалить всё" Click="DeleteAllCategories_Click"
                                    Background="#D32F2F" Foreground="White" FontSize="16" FontWeight="Bold"
                                    Padding="15,10" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="CategoryForm" Background="#2d2d2d" Padding="25" CornerRadius="10" 
                            Margin="0,0,0,20" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="CategoryFormTitle" Text="Добавление категории" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                            <TextBlock Text="Название" Margin="0,0,0,5"/>
                            <TextBox x:Name="CategoryName" FontSize="16" Padding="10" Background="#1a1a1a" 
                                     Foreground="White" BorderBrush="#4a4a4a" Width="400" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="📷 Выбрать фото" Click="UploadCategoryImage_Click"
                                        Background="#FF9800" Foreground="White" FontSize="14" FontWeight="Bold"
                                        Padding="15,8" BorderThickness="0" Cursor="Hand"/>
                                <TextBlock x:Name="CategoryImagePath" Text="" FontSize="12" Foreground="#aaaaaa" 
                                           VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <Button Content="💾 Сохранить" Click="SaveCategory_Click"
                                        Background="#9C27B0" Foreground="White" FontSize="16" FontWeight="Bold"
                                        Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                                <Button Content="❌ Отмена" Click="CancelForm_Click"
                                        Background="#ff4444" Foreground="White" FontSize="16" FontWeight="Bold"
                                        Padding="20,10" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="CategoriesList" ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,5" Background="#2d2d2d" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="✏️" Tag="{Binding}" Click="EditCategory_Click"
                                                    Background="#2196F3" Foreground="White" Width="35" Height="35"
                                                    BorderThickness="0" Cursor="Hand" Margin="0,0,5,0"/>
                                            <Button Content="🗑️" Tag="{Binding}" Click="DeleteCategory_Click"
                                                    Background="#ff4444" Foreground="White" Width="35" Height="35"
                                                    BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ====== ЗАКАЗЫ ====== -->
                <StackPanel x:Name="OrdersPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="📋 ИСТОРИЯ ЗАКАЗОВ" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="🔄 Обновить" Click="RefreshOrders_Click"
                                    Background="#2196F3" Foreground="White" FontSize="14" FontWeight="Bold"
                                    Padding="12,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>

                            <!-- Кнопка "Удалить все заказы" -->
                            <Button Content="🗑️ Удалить всё" Click="DeleteAllOrders_Click"
                                    Background="#D32F2F" Foreground="White" FontSize="14" FontWeight="Bold"
                                    Padding="12,8" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="OrdersList">

                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>