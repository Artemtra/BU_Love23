<Window x:Class="BU_Love.Views.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в админ-панель" 
        Width="450" Height="450"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a1a"
        Foreground="White"
        FontFamily="Segoe UI">

    <Border Background="#2d2d2d" CornerRadius="15" Margin="20">
        <StackPanel VerticalAlignment="Center" Margin="30">
            <TextBlock Text="🔑" FontSize="48" TextAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="ВХОД В АДМИН-ПАНЕЛЬ" 
                       FontSize="24" 
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,30"/>

            <TextBlock Text="Логин" FontSize="16" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginBox"
                     FontSize="18" 
                     Padding="12" 
                     Background="#1a1a1a"
                     Foreground="White"
                     BorderThickness="2"
                     BorderBrush="#4a4a4a"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Пароль" FontSize="16" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox"
                         FontSize="18" 
                         Padding="12"
                         Background="#1a1a1a"
                         Foreground="White"
                         BorderThickness="2"
                         BorderBrush="#4a4a4a"
                         Margin="0,0,0,30"/>

            <Button x:Name="LoginButton"
                    Content="ВОЙТИ"
                    Click="LoginButton_Click"
                    Background="#4CAF50"
                    Foreground="White"
                    FontSize="20"
                    FontWeight="Bold"
                    Padding="15,12"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,0,15"/>

            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Click="CancelButton_Click"
                    Background="Transparent"
                    Foreground="#aaaaaa"
                    FontSize="16"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>