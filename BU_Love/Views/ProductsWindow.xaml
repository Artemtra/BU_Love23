<Window x:Class="BU_Love.Views.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товары" 
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1a1a1a"
        Foreground="White"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="30,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="← НАЗАД" 
                            Click="BackButton_Click"
                            FontSize="20"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <TextBlock x:Name="CategoryTitle" 
                               Text="Товары"
                               FontSize="28" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>
                </StackPanel>

                <Button Content="🛒 КОРЗИНА" 
                        Click="CartButton_Click"
                        Background="#2196F3"
                        Foreground="White"
                        FontSize="18"
                        FontWeight="Bold"
                        Padding="25,12"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Products Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel Margin="20" x:Name="ProductsWrapPanel">
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</Window>