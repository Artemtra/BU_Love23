<Window x:Class="BU_Love.Views.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товары" 
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1a1a1a"
        Foreground="White"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="30,0">
            <Grid>
                <Button Content="← НАЗАД" Click="BackButton_Click"
                        FontSize="20" Background="Transparent" Foreground="White"
                        BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"/>
                <TextBlock x:Name="CategoryTitle" Text="ТОВАРЫ" FontSize="28" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="🛒 КОРЗИНА" Click="CartButton_Click"
                        Background="#2196F3" Foreground="White" FontSize="18" FontWeight="Bold"
                        Padding="25,12" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Поиск -->
        <Border Grid.Row="1" Background="#252525" Padding="12,10" Margin="30,15,30,0" CornerRadius="10" 
                BorderBrush="#333" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" 
                         Background="#2d2d2d" Foreground="White" BorderBrush="#555"
                         BorderThickness="2" FontSize="15" Padding="12,10"
                         CaretBrush="#FF9800" TextChanged="SearchBox_TextChanged"/>
                <Button Grid.Column="2" Content="✕" Click="ClearSearch_Click"
                        Background="Transparent" Foreground="#888" FontSize="16" 
                        BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- Товары -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="30,15,30,30">
            <WrapPanel x:Name="ProductsWrapPanel" HorizontalAlignment="Center"/>
        </ScrollViewer>
    </Grid>
</Window>