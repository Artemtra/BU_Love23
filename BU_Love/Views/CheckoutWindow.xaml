<Window x:Class="BU_Love.Views.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление заказа" Width="600" Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#1a1a1a" CornerRadius="15" BorderBrush="#FF9800" BorderThickness="2">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="📋 ОФОРМЛЕНИЕ ЗАКАЗА" FontSize="24" FontWeight="Bold" 
                           Foreground="#FF9800" HorizontalAlignment="Left"/>
                <Button Content="✕" Click="CloseButton_Click" HorizontalAlignment="Right"
                        Background="#ff4444" Foreground="White" Width="40" Height="40"
                        FontSize="20" BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <StackPanel Grid.Row="1">
                <!-- Данные покупателя (показываются если НЕ в аккаунте) -->
                <Border x:Name="UserDataPanel" Background="#2d2d2d" Padding="20" CornerRadius="10" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Данные покупателя" FontSize="18" FontWeight="Bold" 
                                   Foreground="#FF9800" Margin="0,0,0,15"/>

                        <TextBlock Text="Имя" Margin="0,0,0,5"/>
                        <TextBox x:Name="CustomerNameTextBox" FontSize="16" Padding="10" 
                                 Background="#1a1a1a" Foreground="White" BorderBrush="#4a4a4a" Margin="0,0,0,10"/>

                        <TextBlock Text="Телефон" Margin="0,0,0,5"/>
                        <TextBox x:Name="PhoneTextBox" FontSize="16" Padding="10" 
                                 Background="#1a1a1a" Foreground="White" BorderBrush="#4a4a4a" Margin="0,0,0,10"/>

                        <TextBlock Text="Адрес доставки" Margin="0,0,0,5"/>
                        <TextBox x:Name="AddressTextBox" FontSize="16" Padding="10" 
                                 Background="#1a1a1a" Foreground="White" BorderBrush="#4a4a4a" 
                                 Height="60" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Информация для авторизованного пользователя -->
                <Border x:Name="LoggedInInfoPanel" Background="#2d2d2d" Padding="20" CornerRadius="10" 
                        Margin="0,0,0,15" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="LoggedInNameText" FontSize="18" FontWeight="Bold" Foreground="#4CAF50"/>
                        <TextBlock x:Name="LoggedInPhoneText" FontSize="14" Foreground="#aaaaaa" Margin="0,5,0,0"/>
                        <TextBlock x:Name="LoggedInAddressText" FontSize="14" Foreground="#aaaaaa" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Бонусы (только для авторизованных) -->
                <Border x:Name="BonusPanel" Background="#2d2d2d" Padding="20" CornerRadius="10" 
                        Margin="0,0,0,15" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="🎁 Бонусная программа" FontSize="18" FontWeight="Bold" 
                                   Foreground="#FF9800" Margin="0,0,0,10"/>
                        <TextBlock x:Name="BonusInfoText" FontSize="14" Foreground="#aaaaaa" Margin="0,0,0,10"/>
                        <CheckBox x:Name="UseBonusCheckBox" Content="Списать бонусы" 
                                  Foreground="White" FontSize="16" Margin="0,5,0,0"
                                  Checked="UseBonusCheckBox_Changed" 
                                  Unchecked="UseBonusCheckBox_Changed"/>
                        <TextBlock x:Name="BonusAfterPurchaseText" Text="" FontSize="14" 
                                   Foreground="#4CAF50" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Итоговая сумма -->
                <Border Background="#2d2d2d" Padding="20" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Сумма заказа:" FontSize="16" Foreground="#aaaaaa"/>
                        <TextBlock x:Name="TotalAmountText" FontSize="36" FontWeight="Bold" 
                                   Foreground="#4CAF50" Margin="0,5,0,0"/>
                        <TextBlock x:Name="TotalCountText" FontSize="14" Foreground="#aaaaaa"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button Grid.Row="2" Content="✅ ПОДТВЕРДИТЬ ЗАКАЗ" Click="ConfirmOrder_Click"
                    Background="#4CAF50" Foreground="White" FontSize="20" FontWeight="Bold"
                    Padding="20,15" BorderThickness="0" Cursor="Hand" Margin="0,20,0,0"/>
        </Grid>
    </Border>
</Window>