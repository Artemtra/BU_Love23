<Window x:Class="BU_Love.Views.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление заказа" 
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1a1a1a"
        Foreground="White"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="30,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="← НАЗАД" 
                        Click="BackButton_Click"
                        FontSize="20"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <TextBlock Text="ОФОРМЛЕНИЕ ЗАКАЗА" 
                           FontSize="28" 
                           FontWeight="Bold"
                           Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="450"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0">
                <StackPanel MaxWidth="600" Margin="50" VerticalAlignment="Center">
                    <TextBlock Text="КОНТАКТНЫЕ ДАННЫЕ" 
                               FontSize="28" 
                               FontWeight="Bold"
                               Margin="0,0,0,30"/>

                    <TextBlock Text="Ваше имя" FontSize="18" Margin="0,0,0,8"/>
                    <TextBox x:Name="NameBox"
                             FontSize="20" 
                             Padding="15" 
                             Background="#2d2d2d"
                             Foreground="White"
                             BorderThickness="2"
                             BorderBrush="#4a4a4a"
                             Margin="0,0,0,20"/>

                    <TextBlock Text="Телефон" FontSize="18" Margin="0,0,0,8"/>
                    <TextBox x:Name="PhoneBox"
                             FontSize="20" 
                             Padding="15"
                             Background="#2d2d2d"
                             Foreground="White"
                             BorderThickness="2"
                             BorderBrush="#4a4a4a"
                             Margin="0,0,0,20"/>

                    <TextBlock Text="Адрес доставки" FontSize="18" Margin="0,0,0,8"/>
                    <TextBox x:Name="AddressBox"
                             FontSize="20" 
                             Padding="15"
                             Background="#2d2d2d"
                             Foreground="White"
                             BorderThickness="2"
                             BorderBrush="#4a4a4a"
                             Height="100"
                             TextWrapping="Wrap"
                             Margin="0,0,0,30"/>

                    <Button x:Name="SubmitButton"
                            Content="ПОДТВЕРДИТЬ ЗАКАЗ"
                            Click="SubmitButton_Click"
                            Background="#4CAF50"
                            Foreground="White"
                            FontSize="22"
                            FontWeight="Bold"
                            Padding="20,15"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Order Summary -->
            <Border Grid.Column="1" Background="#2d2d2d" Padding="30">
                <StackPanel>
                    <TextBlock Text="ВАШ ЗАКАЗ" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <ScrollViewer Height="500">
                        <ItemsControl ItemsSource="{Binding CartItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="15" 
                                            Margin="0,5" 
                                            Background="#1a1a1a" 
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Product.Name}" 
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Quantity, StringFormat=Кол-во: {0}}" 
                                                           FontSize="14" 
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding TotalPrice, StringFormat={}{0:C}}" 
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#4CAF50"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Margin="0,20,0,0" 
                            Padding="0,20,0,0" 
                            BorderThickness="0,2,0,0" 
                            BorderBrush="#4CAF50">
                        <StackPanel>
                            <TextBlock Text="ИТОГО К ОПЛАТЕ:" FontSize="20"/>
                            <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:C}}" 
                                       FontSize="36" 
                                       FontWeight="Bold"
                                       Foreground="#4CAF50"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>