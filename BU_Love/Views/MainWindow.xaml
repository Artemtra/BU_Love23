<Window x:Class="BU_Love.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USED TECH SHOP" 
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1a1a1a"
        Foreground="White"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="30,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📱" FontSize="36" Margin="0,0,15,0"/>
                    <TextBlock Text="BU_Love" FontSize="32" FontWeight="Bold" Foreground="#4CAF50"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Кнопка обновления -->
                    <Button x:Name="RefreshButton" Content="🔄 Обновить" Click="RefreshButton_Click"
                            Background="#4CAF50" Foreground="White" FontSize="18" FontWeight="Bold"
                            Padding="25,12" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#45a049"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#3d8b40"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🛒 КОРЗИНА" Click="CartButton_Click"
                            Background="#2196F3" Foreground="White" FontSize="18" FontWeight="Bold"
                            Padding="25,12" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0"/>
                    <Button Content="🔑 АДМИН" Click="AdminButton_Click"
                            Background="#FF9800" Foreground="White" FontSize="18" FontWeight="Bold"
                            Padding="25,12" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Категории -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <WrapPanel x:Name="CategoriesPanel" Margin="30" HorizontalAlignment="Center"/>

                <!-- Индикатор загрузки -->
                <Border x:Name="LoadingOverlay" Background="#CC1a1a1a" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🔄" FontSize="48" TextAlignment="Center"/>
                        <TextBlock Text="Обновление..." FontSize="20" Foreground="White" 
                                   TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#2d2d2d" Padding="30,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="CartInfo" FontSize="20" VerticalAlignment="Center"/>
                <TextBlock x:Name="UpdateInfo" FontSize="14" Foreground="#aaaaaa" 
                           Margin="30,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>