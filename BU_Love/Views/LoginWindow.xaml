<Window x:Class="BU_Love.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Width="450" Height="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#1a1a1a" CornerRadius="15" BorderBrush="#FF9800" BorderThickness="2">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="TitleText" Text="Вход" FontSize="28" FontWeight="Bold" 
                           HorizontalAlignment="Center" Foreground="#FF9800"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LoginTabBtn" Content="ВХОД" Click="LoginTab_Click"
                            Background="#FF9800" Foreground="White" FontSize="16" FontWeight="Bold"
                            Padding="10" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="RegisterTabBtn" Content="РЕГИСТРАЦИЯ" Click="RegisterTab_Click"
                            Grid.Column="1" Background="#2d2d2d" Foreground="#aaaaaa" FontSize="16" 
                            FontWeight="Bold" Padding="10" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <StackPanel x:Name="LoginPanel">
                    <TextBlock Text="Логин" Margin="0,0,0,5"/>
                    <TextBox x:Name="LoginUsername" FontSize="16" Padding="10" 
             Background="#2d2d2d" Foreground="White" Margin="0,0,0,10"/>

                    <TextBlock Text="Пароль" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="LoginPassword" Grid.Column="0" FontSize="16" Padding="10" 
                     Background="#2d2d2d" Foreground="White"/>
                        <TextBox x:Name="LoginPasswordVisible" Grid.Column="0" FontSize="16" Padding="10" 
                 Background="#2d2d2d" Foreground="White" Visibility="Collapsed"/>
                        <Button x:Name="LoginEyeBtn" Grid.Column="1" Content="👁" Click="ToggleLoginPassword_Click"
        Background="Transparent" Foreground="#888" FontSize="20"
        BorderThickness="0" Cursor="Hand" Width="35" Margin="5,0,0,0"
        Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                    <TextBlock Text="Логин" Margin="0,0,0,5"/>
                    <TextBox x:Name="RegUsername" FontSize="16" Padding="10" 
             Background="#2d2d2d" Foreground="White" Margin="0,0,0,10"/>

                    <TextBlock Text="Пароль" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="RegPassword" Grid.Column="0" FontSize="16" Padding="10" 
                     Background="#2d2d2d" Foreground="White"/>
                        <TextBox x:Name="RegPasswordVisible" Grid.Column="0" FontSize="16" Padding="10" 
                 Background="#2d2d2d" Foreground="White" Visibility="Collapsed"/>
                        <Button x:Name="RegEyeBtn" Grid.Column="1" Content="👁" Click="ToggleRegPassword_Click"
        Background="Transparent" Foreground="#888" FontSize="20"
        BorderThickness="0" Cursor="Hand" Width="35" Margin="5,0,0,0"
        Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <TextBlock Text="Телефон" Margin="0,10,0,5"/>
                    <TextBox x:Name="RegPhone" FontSize="16" Padding="10" 
             Background="#2d2d2d" Foreground="White" Margin="0,0,0,10"/>

                    <TextBlock Text="Адрес доставки" Margin="0,0,0,5"/>
                    <TextBox x:Name="RegAddress" FontSize="16" Padding="10" 
             Background="#2d2d2d" Foreground="White" Height="60" 
             TextWrapping="Wrap" Margin="0,0,0,15"/>
                </StackPanel>

                <TextBlock x:Name="BonusInfo" Text="" FontSize="14" Foreground="#4CAF50" 
                           TextAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <Button x:Name="SubmitBtn" Content="ВОЙТИ" Click="SubmitButton_Click"
                        Background="#FF9800" Foreground="White" FontSize="18" FontWeight="Bold"
                        Padding="15" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10"/>
                <Button Content="ОТМЕНА" Click="CancelButton_Click"
                        Background="#ff4444" Foreground="White" FontSize="14"
                        Padding="10" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>